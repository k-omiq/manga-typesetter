{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions. The fs:scope allow and deny lists below are mirrored in tauri.conf.json under app.security.assetProtocol.scope - asset:// is a separate scope that inherits nothing from here, so BOTH pairs of lists must be edited together and must stay identical; the test `the_two_scope_deny_lists_are_identical` in src/lib.rs enforces that rather than trusting this sentence. The deny list covers three platforms: $HOME resolves to %USERPROFILE% on Windows, where - unlike unix - a leading dot is NOT literal, so $HOME/** reaches dotfiles there too and the AppData entries are what stand in for the unix dot-directories. Consequence of the $HOME/** allow: a library root outside the home directory (an external volume, a network share) is not supported in this slice. Widening it means widening the asset scope in the same commit.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "updater:default",
    "process:default",
    "core:app:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.config/gh/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.azure/**" },
        { "path": "$HOME/.config/gcloud/**" },
        { "path": "$HOME/.netrc" },
        { "path": "$HOME/.npmrc" },
        { "path": "$HOME/.zsh_history" },
        { "path": "$HOME/.bash_history" },
        { "path": "$HOME/.tauri/**" },
        { "path": "$HOME/Library/Keychains/**" },
        { "path": "$HOME/AppData/Roaming/Microsoft/Protect/**" },
        { "path": "$HOME/AppData/Roaming/Microsoft/Crypto/**" },
        { "path": "$HOME/AppData/Local/Microsoft/Credentials/**" },
        { "path": "$HOME/AppData/Roaming/Microsoft/Credentials/**" },
        { "path": "$HOME/AppData/Local/Microsoft/Vault/**" },
        { "path": "$HOME/AppData/Local/Microsoft/TokenBroker/**" },
        { "path": "$HOME/AppData/Local/Google/Chrome/User Data/**" },
        { "path": "$HOME/AppData/Local/Microsoft/Edge/User Data/**" },
        { "path": "$HOME/AppData/Roaming/Mozilla/Firefox/**" },
        { "path": "$HOME/AppData/Roaming/Microsoft/Windows/PowerShell/PSReadLine/**" },
        { "path": "$HOME/AppData/Roaming/GitHub CLI/**" },
        { "path": "$HOME/AppData/Roaming/gcloud/**" },
        { "path": "$HOME/NTUSER.DAT*" }
      ]
    }
  ]
}
